diff --git a/protocol/wireguard/endpoint.go b/protocol/wireguard/endpoint.go
index b20f4580..f40e7a2b 100644
--- a/protocol/wireguard/endpoint.go
+++ b/protocol/wireguard/endpoint.go
@@ -4,0 +5 @@ import (
+	"errors"
@@ -166,0 +168,14 @@ func (w *Endpoint) Close() error {
+func (w *Endpoint) IpcGet() (string, error) {
+	if w.endpoint == nil {
+		return "", errors.New("wireguard endpoint is not initialized")
+	}
+	return w.endpoint.IpcGet()
+}
+
+func (w *Endpoint) IpcSet(config string) error {
+	if w.endpoint == nil {
+		return errors.New("wireguard endpoint is not initialized")
+	}
+	return w.endpoint.IpcSet(config)
+}
+
diff --git a/protocol/wireguard/endpoint_ipc_test.go b/protocol/wireguard/endpoint_ipc_test.go
new file mode 100644
index 00000000..73272308
--- /dev/null
+++ b/protocol/wireguard/endpoint_ipc_test.go
@@ -0,0 +1,15 @@
+package wireguard
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestEndpointIPCBeforeInitialization(t *testing.T) {
+	endpoint := new(Endpoint)
+
+	_, err := endpoint.IpcGet()
+	require.EqualError(t, err, "wireguard endpoint is not initialized")
+	require.EqualError(t, endpoint.IpcSet(""), "wireguard endpoint is not initialized")
+}
